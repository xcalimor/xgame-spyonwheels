<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- WI-015: the Xorpheus modules come as versioned packages from the studio's local feed (his ruling 2026-11-17);
       this repo never references the Xorpheus source. Pack them with xgame-tools-xorpheus/pack-modules.ps1. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="xgame" value="D:\dev\packages\xgame" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="xgame">
      <package pattern="XGame.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
